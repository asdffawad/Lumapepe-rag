# ============================================================
# RAG 电商智能客服系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# === LLM 配置（必填） ===
LLM_PROVIDER=qwen
LLM_MODEL_NAME=qwen-max
# 降级模型列表（逗号分隔，当主模型不可用时自动切换）
LLM_FALLBACK_MODELS=qwen-plus,qwen-turbo
DASHSCOPE_API_KEY=your-dashscope-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# === 安全配置 ===
# JWT Secret（必填，生产环境请使用随机字符串）
JWT_SECRET=your-jwt-secret-here
# API Keys（可选，格式: key_id:secret:role,key_id2:secret2:role2）
# API_KEYS=service1:secret1:admin,service2:secret2:api_user
# 允许的 CORS 域名（多个用逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# === MySQL 配置 ===
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=rag_customer_service
MYSQL_POOL_SIZE=10

# === Redis 配置 ===
REDIS_URL=redis://redis:6379/0
REDIS_DB=0

# === Milvus 配置 ===
# Docker 环境中使用容器名 milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# === Celery 配置 ===
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# === 限流配置 ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_USER=60
RATE_LIMIT_WINDOW=60

# === RAG 配置 ===
RAG_TOP_K=10
RAG_RERANK_TOP_K=5

# === 监控配置 ===
DEBUG=false
