# Celery Async Patterns

## 概述

Celery 负责所有 CPU/IO 密集型耗时任务（文档解析、文本切块、向量化、向量入库），避免阻塞 FastAPI 主流程。任务设计遵循幂等性、重试策略和队列分离原则。

## 目录结构

```
backend/
├── celery_app/
│   ├── __init__.py            # Celery app 实例
│   ├── celery_config.py       # Broker、Backend、任务配置
│   └── tasks/
│       ├── __init__.py
│       ├── doc_parser.py      # 文档解析任务
│       ├── chunker.py         # 文本切块任务
│       ├── embed_task.py      # 向量化任务
│       └── vector_index.py     # 向量入库任务
```

## Celery App 配置

```python
# celery_app/celery_config.py
from celery import Celery

def make_celery():
    celery = Celery(
        "rag_customer_service",
        broker=os.getenv("CELERY_BROKER_URL", "redis://localhost:6379/1"),
        backend=os.getenv("CELERY_RESULT_BACKEND", "redis://localhost:6379/2"),
        include=["celery_app.tasks"],
    )

    celery.conf.update(
        task_serializer="json",
        accept_content=["json"],
        result_serializer="json",
        timezone="Asia/Shanghai",
        enable_utc=True,
        task_track_started=True,
        task_acks_late=True,          # 任务完成后再确认，防止丢失
        worker_prefetch_multiplier=1,  # 防止任务分配不均
        task_routes={
            "celery_app.tasks.doc_parser.*": {"queue": "documents"},
            "celery_app.tasks.chunker.*":    {"queue": "documents"},
            "celery_app.tasks.embed_task.*": {"queue": "embedding"},
            "celery_app.tasks.vector_index.*": {"queue": "embedding"},
        },
        task_annotations={
            "celery_app.tasks.embed_task.embed_batch": {
                "rate_limit": "100/m"  # 向量化任务限速
            }
        },
        beat_schedule={
            "cleanup-old-logs": {
                "task": "celery_app.tasks.cleanup_old_logs",
                "schedule": 86400.0,  # 每天清理一次
            },
            "refresh-hot-questions": {
                "task": "celery_app.tasks.refresh_hot_questions",
                "schedule": 3600.0,   # 每小时刷新热点
            },
        },
    )
    return celery
```

```python
# celery_app/__init__.py
from celery_app.celery_config import make_celery
celery_app = make_celery()
```

## 任务链规范

文档处理流水线，严格按顺序执行：

```mermaid
flowchart LR
    DOC[文档上传] --> PARSE[doc_parser.parse_document] --> CHUNK[chunker.chunk_text] --> EMBED[embed_task.embed_batch] --> INDEX[vector_index.index_batch]
```

### 任务 1: 文档解析

```python
# celery_app/tasks/doc_parser.py
from celery import chain, group
from celery_app import celery_app
from celery_app.tasks.chunker import chunk_text
import pypdf
import docx

@celery_app.task(bind=True, max_retries=3, default_retry_delay=60)
def parse_document(self, file_path: str, doc_id: int):
    """
    解析 PDF/Word/HTML 文档，提取纯文本
    幂等: 相同文件路径重复执行返回相同结果
    """
    try:
        ext = os.path.splitext(file_path)[1].lower()
        if ext == ".pdf":
            text = extract_pdf(file_path)
        elif ext in [".docx", ".doc"]:
            text = extract_docx(file_path)
        elif ext == ".html":
            text = extract_html(file_path)
        else:
            raise ValueError(f"Unsupported file type: {ext}")

        # 用 hash 去重，幂等保证
        file_hash = hashlib.md5(open(file_path, "rb").read()).hexdigest()

        # 链式调用下一个任务
        chain(
            chunk_text.s(text, doc_id, file_hash),
            embed_batch.si(doc_id),
            vector_index.si(doc_id),
        ).apply_async()

        return {"status": "parsed", "doc_id": doc_id, "text_length": len(text)}

    except Exception as exc:
        self.retry(exc=exc, countdown=2 ** self.request.retries)
```

### 任务 2: 文本切块

```python
# celery_app/tasks/chunker.py
@celery_app.task(bind=True, max_retries=3)
def chunk_text(self, text: str, doc_id: int, file_hash: str):
    """
    将长文本按语义切块
    策略: 递归字符分割 + 句子边界检测
    """
    from services.chunker import RecursiveChunker

    chunker = RecursiveChunker(
        chunk_size=512,        # tokens（留余量给 tokenize 开销）
        chunk_overlap=50,      # 重叠 tokens
        separators=["\n\n", "\n", "。", "！", "？", " "]
    )
    chunks = chunker.split(text)

    # 过滤过短的 chunk
    chunks = [c for c in chunks if len(c.strip()) > 50]

    return {
        "chunks": chunks,
        "doc_id": doc_id,
        "file_hash": file_hash,
        "chunk_count": len(chunks),
    }
```

### 任务 3: 向量化

```python
# celery_app/tasks/embed_task.py
@celery_app.task(bind=True, rate_limit="100/m", max_retries=3)
def embed_batch(self, chunk_data: dict):
    """
    批量向量化，使用 Embedding 服务
    幂等: 相同 doc_id + chunk 顺序产生相同向量
    """
    from services.embedding_service import EmbeddingService

    chunks = chunk_data["chunks"]
    embeddings = EmbeddingService.embed_batch(chunks)

    return {
        "doc_id": chunk_data["doc_id"],
        "file_hash": chunk_data["file_hash"],
        "chunks": chunks,
        "embeddings": embeddings,
        "chunk_count": len(chunks),
    }
```

### 任务 4: 向量入库

```python
# celery_app/tasks/vector_index.py
@celery_app.task(bind=True, max_retries=3)
def vector_index(self, embed_data: dict):
    """
    将向量写入 Milvus，同时更新 MySQL documents 表状态
    """
    from services.milvus_client import MilvusClient
    from database.connection import Database

    db = await Database.connect()
    milvus = MilvusClient()

    # 写入 Milvus
    milvus.insert_vectors(
        collection_name="knowledge_base",
        vectors=embed_data["embeddings"],
        ids=[f"{embed_data['doc_id']}_{i}" for i in range(embed_data["chunk_count"])],
        metadata=[{
            "doc_id": embed_data["doc_id"],
            "chunk_index": i,
            "content": embed_data["chunks"][i][:200],  # 截断存元数据
        } for i in range(embed_data["chunk_count"])]
    )

    # 更新 MySQL 状态
    await db.document_repo.mark_indexed(embed_data["doc_id"])

    return {"status": "indexed", "doc_id": embed_data["doc_id"]}
```

## 重试策略

```python
# 全局默认重试配置
task_acks_late = True          # 任务处理完才确认
task_reject_on_worker_lost = True  # worker 挂掉时重新入队

# 单任务重试（指数退避）
@celery_app.task(bind=True, max_retries=3, default_retry_delay=60)
def embed_batch(self, data):
    try:
        ...
    except (ConnectionError, TimeoutError) as exc:
        # 指数退避: 60s -> 120s -> 240s
        delay = 60 * (2 ** self.request.retries)
        self.retry(exc=exc, countdown=delay)
```

## Celery Beat 定时任务

```python
# celery_app/tasks/scheduler.py
@celery_app.task
def cleanup_old_logs():
    """每天清理 30 天前的日志"""
    from database.connection import Database
    db = await Database.connect()
    await db.log_repo.delete_older_than(days=30)

@celery_app.task
def refresh_hot_questions():
    """每小时从 MySQL 重新计算热点问题，写入 Redis"""
    from database.connection import Database
    from cache.hot_question import HotQuestionCache
    db = await Database.connect()
    cache = HotQuestionCache()
    hot_queries = await db.message_repo.get_hot_queries(limit=100)
    for query, score in hot_queries:
        await cache.record(query)  # 更新 ZSet
```

## FastAPI 集成

```python
# api/admin.py
from fastapi import BackgroundTasks

@router.post("/documents/upload")
async def upload_document(
    file: UploadFile,
    background_tasks: BackgroundTasks,
):
    # 1. 保存文件到本地/S3
    file_path = await save_file(file)

    # 2. 创建文档记录
    doc = await db.document_repo.create(DocumentCreate(
        title=file.filename,
        file_path=file_path,
        doc_type="manual",
        status="pending"
    ))

    # 3. 触发 Celery 任务链
    from celery_app import celery_app
    from celery_app.tasks.doc_parser import parse_document

    celery_app.delay(parse_document.request.id, file_path, doc.id)

    return {"doc_id": doc.id, "status": "pending", "message": "文档正在处理中"}
```

## 禁止事项

- **禁止**在 Celery 任务中使用 `time.sleep()`（用 `asyncio.sleep()` 或 `celery_app.sleep()`）
- **禁止**在任务中硬编码 Redis/MySQL/Milvus 连接参数（从环境变量或 config 读取）
- **禁止**在任务中 `print()` 调试（用 `celery_app.log` 或 `structlog`）
- **禁止**任务链中前一个任务抛出异常后静默继续（后续任务通过 `apply_async` 的 `link_error` 统一处理）
- **禁止**将超过 100MB 的数据通过 Celery 消息体传递（大文件用 S3 路径替代）
