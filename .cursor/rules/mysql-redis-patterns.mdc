# MySQL + Redis Patterns

## 概述

MySQL 作为结构化持久存储（会话、消息、文档元数据、日志），Redis 作为多级缓存（会话、热点问题、Embedding、限流）。数据层操作统一封装在 `database/` 和 `cache/` 目录，业务层禁止直接操作存储引擎。

## MySQL

### 目录结构

```
database/
├── connection.py      # 连接池管理（单例）
├── session.py         # sessions 表 CRUD
├── message.py         # messages 表 CRUD
├── document.py        # documents 表 CRUD
└── log.py            # logs 表 CRUD
```

### 连接池规范

```python
# database/connection.py
import asyncpg
from functools import lru_cache

@dataclass
class DBConfig:
    host: str
    port: int
    user: str
    password: str
    database: str
    pool_size: int = 10
    max_queries: int = 50000

class Database:
    _instance: "Database | None" = None
    _pool: asyncpg.Pool | None = None

    @classmethod
    async def connect(cls, config: DBConfig) -> "Database":
        if cls._instance is None:
            cls._instance = cls()
            cls._pool = await asyncpg.create_pool(
                host=config.host,
                port=config.port,
                user=config.user,
                password=config.password,
                database=config.database,
                min_size=5,
                max_size=config.pool_size,
            )
        return cls._instance

    @classmethod
    async def disconnect(cls):
        if cls._pool:
            await cls._pool.close()
            cls._pool = None
            cls._instance = None

    @property
    def pool(self) -> asyncpg.Pool:
        if self._pool is None:
            raise RuntimeError("Database not connected. Call Database.connect() first.")
        return self._pool
```

### CRUD 规范

每个表对应一个 CRUD 类，继承统一基类：

```python
# database/base.py
from asyncpg import Pool
from typing import TypeVar, Generic, Type
from dataclasses import dataclass

T = TypeVar("T")

class BaseRepository(Generic[T]):
    def __init__(self, pool: Pool, table_name: str, model_cls: Type[T]):
        self.pool = pool
        self.table_name = table_name
        self.model_cls = model_cls

    async def find_by_id(self, id: str) -> T | None:
        async with self.pool.acquire() as conn:
            row = await conn.fetchrow(
                f"SELECT * FROM {self.table_name} WHERE id = $1", id
            )
            return self.model_cls(**row) if row else None

    async def insert(self, data: T) -> T:
        async with self.pool.acquire() as conn:
            cols = ", ".join(data.__dataclass_fields__.keys())
            vals = ", ".join(f"${i+1}" for i in range(len(data.__dataclass_fields__)))
            row = await conn.fetchrow(
                f"INSERT INTO {self.table_name} ({cols}) VALUES ({vals}) "
                f"RETURNING *",
                *(getattr(data, f) for f in data.__dataclass_fields__)
            )
            return self.model_cls(**row)
```

### JSON 序列化

JSON 字段统一用 `orjson`：

```python
import orjson

def jsonb_field(data: dict) -> bytes:
    """MySQL JSONB 字段序列化"""
    return orjson.dumps(data)

def parse_jsonb_field(raw: bytes | str) -> dict:
    """MySQL JSONB 字段反序列化"""
    if isinstance(raw, str):
        raw = raw.encode()
    return orjson.loads(raw) if raw else {}
```

### 事务规范

事务在 Service 层控制，不在 API 层开启：

```python
# services/session_service.py
async def close_session(self, session_id: str):
    async with self.db.pool.acquire() as conn:
        async with conn.transaction():
            await self.session_repo.update_status(session_id, "closed")
            await self.message_repo.mark_session_closed(session_id)
```

## Redis

### 目录结构

```
cache/
├── redis_client.py      # Redis 连接管理
├── session_cache.py     # 会话上下文缓存
├── hot_question.py      # 热点问题缓存
├── embed_cache.py       # Embedding 结果缓存
└── rate_limiter.py      # 用户限流
```

### Redis 连接规范

```python
# cache/redis_client.py
import redis.asyncio as redis

class RedisClient:
    _instance: "RedisClient | None" = None
    _pool: redis.ConnectionPool | None = None

    @classmethod
    async def connect(cls, url: str = "redis://localhost:6379") -> "RedisClient":
        if cls._instance is None:
            cls._instance = cls()
            cls._pool = redis.ConnectionPool.from_url(url, decode_responses=True)
        return cls._instance
```

### Key 命名规范

```
{domain}:{entity}:{id}:{field}
```

| 用途 | Key Pattern | 类型 | TTL |
|------|------------|------|-----|
| 会话上下文 | `session:{session_id}` | Hash | 30min |
| 对话历史 | `session:{session_id}:history` | List | 30min |
| 热点问题 | `hot:questions:day:{date}` | ZSet | 24h |
| Embedding | `embed:cache:{md5(query)}` | String | 7d |
| 用户限流 | `rate:user:{user_id}:{minute}` | String | 1min |
| 熔断器状态 | `tool:circuit:{tool_name}` | String | 30s |

### Session 缓存规范

```python
# cache/session_cache.py
import redis.asyncio as redis

class SessionCache:
    def __init__(self, redis_client: RedisClient):
        self.r = redis_client

    async def get(self, session_id: str) -> dict | None:
        """读取会话缓存，命中返回，反之 None"""
        key = f"session:{session_id}"
        data = await self.r.get(key)
        return orjson.loads(data) if data else None

    async def set(self, session_id: str, session_data: dict, ttl: int = 1800):
        """写入会话缓存（Write-Through 模式）"""
        key = f"session:{session_id}"
        await self.r.set(key, orjson.dumps(session_data), ex=ttl)

    async def append_message(self, session_id: str, message: dict, ttl: int = 1800):
        """追加消息到历史列表"""
        key = f"session:{session_id}:history"
        pipe = self.r.pipeline()
        pipe.rpush(key, orjson.dumps(message))
        pipe.expire(key, ttl)
        await pipe.execute()
```

### 热点问题缓存

```python
# cache/hot_question.py
class HotQuestionCache:
    async def record(self, query: str):
        """记录问题热度（每分钟窗口）"""
        key = f"hot:questions:day:{date.today()}"
        await self.r.zincrby(key, 1, query)

    async def get_top(self, limit: int = 10) -> list[tuple[str, float]]:
        """获取 top-k 热点问题"""
        key = f"hot:questions:day:{date.today()}"
        return await self.r.zrevrange(key, 0, limit - 1, withscores=True)
```

### Embedding 缓存

```python
# cache/embed_cache.py
import hashlib

class EmbedCache:
    def __init__(self, redis: RedisClient, ttl: int = 7 * 24 * 3600):
        self.r = redis
        self.ttl = ttl

    def _hash(self, text: str) -> str:
        return hashlib.md5(text.encode()).hexdigest()

    async def get(self, text: str) -> list[float] | None:
        key = f"embed:cache:{self._hash(text)}"
        data = await self.r.get(key)
        return orjson.loads(data) if data else None

    async def set(self, text: str, embedding: list[float]):
        key = f"embed:cache:{self._hash(text)}"
        await self.r.set(key, orjson.dumps(embedding), ex=self.ttl)
```

### 限流规范

```python
# cache/rate_limiter.py
class RateLimiter:
    def __init__(self, redis: RedisClient, max_requests: int = 60, window: int = 60):
        self.r = redis
        self.max_requests = max_requests
        self.window = window  # 秒

    async def is_allowed(self, user_id: str) -> bool:
        key = f"rate:user:{user_id}:{int(time.time() // self.window)}"
        count = await self.r.incr(key)
        if count == 1:
            await self.r.expire(key, self.window)
        return count <= self.max_requests
```

## 缓存策略

| 场景 | 策略 | 说明 |
|------|------|------|
| 会话上下文 | Write-Through | 写 MySQL 时同步写 Redis |
| Embedding 结果 | Cache-Aside | 先查 Redis，miss 后查 Milvus 并回填 |
| 热点问题 | Write-Behind | 异步写，避免阻塞主流程 |
| 用户限流 | 直接计数 | Redis INCR + EXPIRE |

## 禁止事项

- **禁止**在业务层（services/）直接 `await redis.get/set` 或 `await pool.fetch`
- **禁止**在 SQL 字符串中使用 f-string 拼接用户输入（用参数化查询 `$1`, `$2`）
- **禁止**存储大于 10MB 的单个 Redis Key（大对象用 Redis Hash 拆分）
- **禁止**使用 `json.dumps()`（用 `orjson` 替代，速度快且支持 dataclass）
