# ==============================================================================
# RAG 智能客服 - 生产环境配置模板
# ==============================================================================
#
# 使用方式：
# 1. 复制此文件为 .env
# 2. 修改所有 "CHANGE_ME" 标记的配置项
# 3. 不要提交 .env 到版本控制！
#
# ==============================================================================
# ⚠️  生产环境必须修改的配置项（未修改将拒绝启动）
# ==============================================================================
#
# 生成命令：
#   openssl rand -hex 32    # JWT_SECRET（64字符）
#   openssl rand -hex 16    # 密码类（32字符）
#   openssl rand -hex 8     # 短密钥（16字符）
#
# ==============================================================================

# ============================================================================
# 基础配置
# ============================================================================

# 环境模式：development / staging / production
ENV=production

# 调试模式（生产必须为 false）
DEBUG=false

# 启动时强校验：true 时禁止不安全的默认配置
ALLOW_INSECURE_CONFIG=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================================
# 🔒 安全配置（必须修改）
# ============================================================================

# JWT 签名密钥（至少 64 字符，推荐使用 openssl rand -hex 32）
# ⚠️ 生产环境必须设置，否则服务拒绝启动
JWT_SECRET=0ecf32314d4b29491af447bbb6d2e26838d42848e479b438e011b63d0e406971

# 管理员 API Key（格式：key_id:secret，推荐使用 openssl rand -hex 16）
# ⚠️ 生产环境必须设置
ADMIN_API_KEYS=admin:2843589595aa43c05e3348b2519c5964

# Redis 密码（推荐使用 openssl rand -hex 16）
# ⚠️ 生产环境必须设置
REDIS_PASSWORD=2843589595aa43c05e3348b2519c5964

# MySQL Root 密码
# ⚠️ 生产环境必须设置
MYSQL_ROOT_PASSWORD=123456

# DashScope API Key
# ⚠️ 生产环境必须设置
DASHSCOPE_API_KEY=sk-c9fca2fde8ba49c982a22412e0b517ad

# ============================================================================
# 🎤 STT (Speech-to-Text) 配置 — Alibaba Cloud DashScope Paraformer
# ============================================================================
# STT 重用上面的 DASHSCOPE_API_KEY，无需单独配置
STT_MODEL=paraformer-realtime-v2
STT_BASE_URL=https://dashscope.aliyuncs.com/api-v1/services/asr
STT_TIMEOUT=30

# ============================================================================
# 🌐 CORS 配置
# ============================================================================

# 允许的源（生产环境必须配置具体域名，逗号分隔）
# ⚠️ 生产环境禁止使用 *，否则服务拒绝启动
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# 🐳 容器化配置
# ============================================================================

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000

# Gunicorn（多 worker 生产推荐值）
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker

# ============================================================================
# 📊 可观测性配置
# ============================================================================

# Prometheus Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# OpenTelemetry Tracing（未来扩展）
ENABLE_TRACING=false
OTEL_SERVICE_NAME=rag-customer-service
OTEL_EXPORTER_ENDPOINT=http://jaeger-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-collector:4318

# 请求追踪
ENABLE_REQUEST_ID=true

# 结构化日志（JSON 格式）
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_TRACE_ID=true

# ============================================================================
# ⚡ WebSocket 配置
# ============================================================================

# 连接限制
WS_MAX_PER_USER=5
WS_MAX_GLOBAL=10000

# 心跳配置
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=60
WS_PING_TIMEOUT=5

# 消息限制
WS_MAX_MESSAGE_SIZE=1048576   # 1MB
WS_RATE_LIMIT_PER_USER=30    # 每用户每分钟消息数
WS_RATE_LIMIT_PER_CONN=20    # 每连接每分钟消息数
WS_RATE_LIMIT_WINDOW=60

# ============================================================================
# 🤖 LLM 配置
# ============================================================================

# LLM Provider：qwen / mock
LLM_PROVIDER=qwen

# 模型配置
LLM_MODEL_NAME=qwen-max
LLM_FALLBACK_MODELS=qwen-plus,qwen-turbo

# API 配置
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Token 限制（安全限制，防止资源耗尽）
LLM_MAX_INPUT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=2048

# ============================================================================
# 🔍 RAG 配置
# ============================================================================

# 检索配置
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_HYBRID_SEARCH=true
RAG_HNSW_AUTO=true
RAG_RRF_K=60
RAG_BM25_WEIGHT=0.3

# LLM 生成超时
RAG_LLM_TIMEOUT_MS=60000
RAG_MAX_CONTEXT_TOKENS=3000

# 查询改写
RAG_REWRITE_TIMEOUT_MS=10000
RAG_REWRITE_ENABLED=true

# ============================================================================
# 🧱 数据库配置
# ============================================================================

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=${MYSQL_ROOT_PASSWORD}
MYSQL_DATABASE=rag_customer_service

# 连接池配置
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=3600
MYSQL_POOL_TIMEOUT=30

# ============================================================================
# 🔗 Redis 配置
# ============================================================================

# Redis 连接（推荐使用 URL 格式）
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_DB=0

# 连接池
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================================
# 🔄 Celery 配置
# ============================================================================

CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=true

# RedBeat（定时任务调度器）
REDBEAT_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/3

# Worker 配置
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_ACKS_LATE=true

# ============================================================================
# 💾 向量数据库配置
# ============================================================================

# Qdrant（推荐，水平扩展能力强）
QDRANT_ENABLED=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=knowledge_base
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=true
QDRANT_VECTOR_DIM=1024
QDRANT_DISTANCE=Cosine

# Milvus（可选，兼容旧配置）
MILVUS_HOST=
MILVUS_PORT=
MILVUS_COLLECTION=knowledge_base
MILVUS_ENTITY_COUNT_HINT=1000000

# ============================================================================
# 🚦 限流配置
# ============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL=200     # 全局每秒最大请求数
RATE_LIMIT_USER=60        # 单用户每秒最大请求数
RATE_LIMIT_WINDOW=60      # 滑动窗口秒数

# ============================================================================
# 📦 数据导入配置
# ============================================================================

AUTO_INGEST=false
DATA_DIR=/app/data
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_UNIT=token
INGEST_BATCH_SIZE=10

# ============================================================================
# 🛒 商品检索配置
# ============================================================================

PRODUCT_ENABLED=true
PRODUCT_DICT_PATH=/app/data/product_dict.json
PRODUCT_RELOAD_INTERVAL=3600
PRODUCT_FUZZY_THRESHOLD=80
PRODUCT_MAX_BATCH_SIZE=100

# ============================================================================
# 🚨 告警配置
# ============================================================================

# LLM 失败告警阈值
ALERT_LLM_FAILURE_THRESHOLD=5
ALERT_LLM_FAILURE_WINDOW=60

# 向量数据库失败告警阈值
ALERT_VECTOR_FAILURE_THRESHOLD=5
ALERT_VECTOR_FAILURE_WINDOW=60

# 延迟告警阈值（毫秒）
ALERT_LATENCY_P99_THRESHOLD=5000

# 内存告警阈值（百分比）
ALERT_MEMORY_THRESHOLD=85

# ============================================================================
# 🔧 开发调试配置（仅开发环境使用）
# ============================================================================

# DEBUG=true 时允许：
#   - JWT_SECRET 使用弱密钥
#   - CORS 使用通配符
#   - 详细错误堆栈

# 允许通过 /api/v1/debug/auth/token 生成测试 Token
# ⚠️ 生产环境必须设为 false
DEBUG_TOKEN_ENABLED=false
